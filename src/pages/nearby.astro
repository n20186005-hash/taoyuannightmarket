---
import TopicPage from "../components/TopicPage.astro";
import TopicLinks from "../components/TopicLinks.astro";
import { nearbyAttractions, nearbyMapUrl } from "../data/nearby";
export const prerender = true;
const crumbs = [{ name: "首頁", href: "/" }, { name: "周邊景點", href: "/nearby/" }];
const nearbyGroups = [
  { title: "桃園舊城與信仰街區", description: "從景福宮出發，沿老街與歷史建物閱讀城市記憶。", slugs: ["jingfu-temple", "xinmin-old-street", "damiaokou-police-station", "cihu-temple", "lianhua-temple"] },
  { title: "歷史建築、展演與藝文", description: "先確認館舍開放與節目時間，再把晚餐留給夜市。", slugs: ["taoyuan-77", "arts-cinema", "micang-theater", "literature-museum", "railway-pavilion"] },
  { title: "公園與城市購物散步", description: "親子綠地、站前商圈都可依天氣與體力彈性搭配。", slugs: ["fenghe-park", "station-district"] }
];
const jsonLd = { "@context": "https://schema.org", "@type": "ItemList", name: "桃園觀光夜市周邊 12 個景點", itemListElement: nearbyAttractions.map((place, i) => ({ "@type": "ListItem", position: i + 1, name: place.name, url: `https://taoyuannightmarket.com/nearby/${place.slug}/` })) };
---
<TopicPage title="桃園觀光夜市周邊景點｜12 個獨立景點與舊城半日遊" description="桃園觀光夜市附近 12 個景點的實景照片、基本資訊與獨立遊覽專頁。探索景福宮、新民老街、桃園77藝文町、米倉劇場、風禾公園等，查看地址、交通與步行路線。" eyebrow="周邊探索" h1="桃園觀光夜市周邊景點與舊城半日遊" lead="把桃園觀光夜市留給傍晚，白天先走桃園舊城。以下 12 個地點均有獨立景點專頁，收錄歷史背景、管理單位、地址、開放資訊、交通、實景照片與拍攝建議。實際步行時間請依當日導航確認。" crumbs={crumbs} jsonLd={jsonLd}>
  <section class="topic-section nearby-management"><p class="eyebrow">行程規劃</p><h2>先認識桃園舊城，再逛夜市</h2><p>初訪可從<strong>桃園車站 → 桃園77藝文町 → 景福宮 → 新民老街 → 桃園觀光夜市</strong>安排一條文化散步線。喜歡展覽可選擇文學館、光影文化館或軌道願景館；有孩子同行則可把風禾公園放在白天。館舍開放和活動規則可能不同，請點入專頁核對。</p><p><a href="/#nearby">首頁附近順遊</a>　・　<a href="/transport/">夜市交通與停車</a></p></section>
  {nearbyGroups.map((group) => <section class="topic-section"><h2>{group.title}</h2><div class="topic-rule"></div><p>{group.description}</p><div class="nearby-directory-grid">{group.slugs.map((slug) => { const place = nearbyAttractions.find((item) => item.slug === slug)!; return <article class="nearby-directory-card"><a href={`/nearby/${place.slug}/`}><img src={place.photo} alt={place.photoAlt} loading="lazy" width="600" height="400" /></a><div class="nearby-directory-copy"><p class="eyebrow">{place.category}・{place.distance}</p><h3><a href={`/nearby/${place.slug}/`}>{place.name}</a></h3><p>{place.introduction}</p><p class="nearby-directory-meta"><strong>建議停留：</strong>{place.duration}<br /><strong>開放：</strong>{place.opening}</p><div class="nearby-directory-actions"><a href={`/nearby/${place.slug}/`}>完整景點指南 →</a><a href={nearbyMapUrl(place)} target="_blank" rel="noopener noreferrer">專屬地圖 ↗</a></div></div></article>; })}</div></section>)}
  <section class="topic-section"><h2>怎麼排成半日遊？</h2><div class="topic-rule"></div><ol class="topic-list"><li>下午從桃園車站周邊出發，依開放資訊選擇桃園77藝文町或新民老街。</li><li>接續前往景福宮，認識桃園舊城宗教與街區脈絡。</li><li>傍晚移動到北埔路與中正路口，開始夜市美食行程；如遇休館，改採戶外街區散步。</li></ol><p><a href="/walking-route/">接著看夜市 60–120 分鐘逛法</a>　・　<a href="/food/">夜市必吃美食</a></p></section>
  <section class="topic-section"><h2>資料來源與地圖說明</h2><div class="topic-rule"></div><p>地點與參考距離：<a href="https://travel.tycg.gov.tw/zh-tw/travel/nearby-attractions/969" target="_blank" rel="noopener noreferrer">桃園市觀光旅遊局夜市周邊景點清單</a>（2026-11-18 查閱）。各景點按名稱建立獨立 Google Maps 搜尋，並非已核實的專屬 Place ID；出發前請再核對正確入口與開館資訊。</p></section>
  <TopicLinks current="nearby" />
</TopicPage>
