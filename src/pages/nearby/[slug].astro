---
import TopicPage from "../../components/TopicPage.astro";
import TopicLinks from "../../components/TopicLinks.astro";
import { nearbyAttractions, nearbyMapUrl, type NearbyAttraction } from "../../data/nearby";
import { nearbyDetails } from "../../data/nearbyDetails";

export const prerender = true;
export function getStaticPaths() {
  return nearbyAttractions.map((place) => ({ params: { slug: place.slug }, props: { place } }));
}

const { place } = Astro.props as { place: NearbyAttraction };
const detail = nearbyDetails[place.slug];
const mapUrl = nearbyMapUrl(place);
const crumbs = [{ name: "首頁", href: "/" }, { name: "周邊景點", href: "/nearby/" }, { name: place.name, href: `/nearby/${place.slug}/` }];
const title = `${place.name}｜地址、歷史特色、交通與桃園夜市順遊指南`;
const description = `${place.name}（${place.english}）旅遊攻略：${place.tagline}。整理地址、開放資訊、特色、步行路線、實景照片與桃園觀光夜市順遊建議。`;
const faq = [
  { question: `${place.name}在哪裡？`, answer: `${place.address}。可從本頁開啟獨立地圖搜尋，導航前確認入口。` },
  { question: `${place.name}需要門票嗎？`, answer: place.admission },
  { question: `${place.name}什麼時間適合去？`, answer: `${place.opening}。${place.duration}，建議先查看管理單位公告。` },
  { question: `如何安排${place.name}與桃園觀光夜市？`, answer: `建議先參觀${place.name}，傍晚再前往北埔路、正康二街一帶的桃園觀光夜市；交通方式請按當日路況規劃。` },
  ...detail.questions
];
const jsonLd = [
  {
    "@context": "https://schema.org", "@type": "TouristAttraction", name: place.name,
    alternateName: place.english, description: place.introduction,
    url: `https://taoyuannightmarket.com/nearby/${place.slug}/`,
    image: `https://taoyuannightmarket.com${place.photo}`,
    address: { "@type": "PostalAddress", streetAddress: place.address, addressLocality: "桃園區", addressRegion: "桃園市", addressCountry: "TW" },
    hasMap: mapUrl
  },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((item) => ({ "@type": "Question", name: item.question, acceptedAnswer: { "@type": "Answer", text: item.answer } })) }
];
---

<TopicPage title={title} description={description} eyebrow={place.category} h1={place.name} lead={place.tagline} crumbs={crumbs} jsonLd={jsonLd} ogImage={place.photo.slice(1)}>
  <div class="nearby-hero-facts" aria-label="景點快速資訊">
    <span>{place.category}</span><span>{place.duration}</span><span>{place.opening}</span><a href={mapUrl} target="_blank" rel="noopener noreferrer">Google 地圖評價・查看最新 ↗</a>
    <a href={mapUrl} target="_blank" rel="noopener noreferrer">查看景點位置 ↗</a>
  </div>
  <figure class="nearby-detail-image">
    <img src={place.photo} alt={place.photoAlt} loading="eager" decoding="async" width="1200" height="800" />
    <figcaption>景點實景照片・<a href={place.photoSource} target="_blank" rel="noopener noreferrer">照片原始來源</a></figcaption>
  </figure>

  <section class="topic-section"><h2>探索{place.name}</h2><div class="topic-rule"></div><p>{place.introduction}</p><p>{detail.visitNarrative}</p><h3>遊覽建議</h3><ul class="topic-list">{place.tips.map((tip) => <li>{tip}</li>)}</ul><h3>景區特色</h3><ul class="topic-list">{place.highlights.map((highlight) => <li>{highlight}</li>)}</ul></section>

  <section class="topic-section nearby-management"><p class="eyebrow">管理與文化背景</p><h2>關於{place.name}</h2><div class="topic-rule"></div><p><strong>管理主體：{detail.manager}。</strong>{detail.managerNote}</p><p class="topic-note">管理資料來源：<a href={detail.managerSource} target="_blank" rel="noopener noreferrer">查看主管機關或管理說明 ↗</a>（2026-11-18 查閱）。</p></section>

  <section class="topic-section"><h2>基本資料</h2><div class="topic-rule"></div><div class="topic-grid cols-2">
    <article class="topic-card"><h3>名稱與類型</h3><p>{place.name}<br />{place.english}<br />{place.category}</p></article>
    <article class="topic-card"><h3>地址</h3><p>{place.address}</p><p><a href={mapUrl} target="_blank" rel="noopener noreferrer">Google 地圖搜尋 ↗</a></p></article>
    <article class="topic-card"><h3>開放資訊</h3><p>{place.opening}</p></article>
    <article class="topic-card"><h3>門票與停留</h3><p>{place.admission}<br />{place.duration}</p></article>
    <article class="topic-card"><h3>管理或營運</h3><p>{detail.manager}</p></article>
    <article class="topic-card"><h3>與夜市關係</h3><p>官方周邊參考距離 {place.distance}，適合按開放時段安排順遊。</p></article>
  </div></section>

  <section class="topic-section"><h2>開放時間與門票</h2><div class="topic-rule"></div><div class="topic-grid cols-2"><article class="topic-card"><h3>一般開放資訊</h3><p>{place.opening}</p><p>特展、節慶、休館與維護可能調整。</p></article><article class="topic-card"><h3>票價與費用</h3><p>{place.admission}</p><p>個別商店、演出或體驗的費用與公共通行不同，請以當期公告為準。</p></article></div></section>

  <section class="topic-section"><h2>交通方式</h2><div class="topic-rule"></div><h3>開車或停車</h3><p>{detail.car}</p><h3>大眾運輸與步行</h3><p>{detail.transit}</p><h3>交通查詢</h3><p><a href={mapUrl} target="_blank" rel="noopener noreferrer">查詢{place.name}專屬地圖 ↗</a>　・　<a href="/transport/">桃園觀光夜市交通專頁</a></p></section>

  <section class="topic-section"><h2>游覽路線與順遊安排</h2><div class="topic-rule"></div><p>與桃園觀光夜市的區域位置參考：{place.distance}。此數字不是實測步行路程，實際請依路線導航。</p><div class="topic-grid cols-3">{place.itinerary.map((item, index) => <article class="topic-card"><p class="eyebrow">第 {index + 1} 站</p><h3>{item}</h3><p>{index === 0 ? "先核對出入口、活動及開放時間；把需要預約或有休館時間的行程安排在前段。" : index === place.itinerary.length - 1 ? "保留交通及用餐彈性，遇到人潮或天候變化可調整停留時間。" : "沿路觀察此景點獨有的建築、文化或自然特色，依現場導引慢行。"}</p></article>)}</div><p><a href="/nearby/">查看其他桃園舊城景點</a>　・　<a href="/walking-route/">夜市步行攻略</a></p></section>

  <section class="topic-section"><h2>發現{place.name}的魅力</h2><div class="topic-rule"></div><h3>歷史背景</h3><p>{place.history}</p><h3>建築與空間特色</h3><p>{place.architecture}</p><h3>地方文化與核心體驗</h3><p>{detail.culture}</p></section>

  <section class="topic-section"><h2>拍照機位與觀察重點</h2><div class="topic-rule"></div><div class="topic-grid cols-3">{detail.photoSpots.map((spot, index) => <article class="topic-card"><p class="eyebrow">機位 {index + 1}</p><h3>{spot.title}</h3><p>{spot.detail}</p></article>)}</div></section>

  <section class="topic-section"><h2>遊覽須知與住宿建議</h2><div class="topic-rule"></div><ul class="topic-list">{place.tips.map((tip) => <li>{tip}</li>)}</ul><p>如果行程安排至晚上，可考慮桃園車站或桃園區市中心交通便利的住宿，先確認實際步行距離、入住時間與回程方式。本站不替特定旅宿背書。</p></section>

  <section class="topic-section"><h2>遊客評價與旅遊印象</h2><div class="topic-rule"></div><p>{place.name}的適合玩法取決於到訪目的：{place.highlights.join("、")}。旅客可比較近期心得是否提到開放安排、參觀動線和現場體驗，再決定停留多久。</p><p>Google 地圖評分與評價數隨時變動，本站不展示未經核實的固定數字。<a href={mapUrl} target="_blank" rel="noopener noreferrer">前往{place.name}的 Google 地圖搜尋並查看最新評價 ↗</a></p></section>

  <section class="topic-section"><h2>交通指南・地址與地圖</h2><div class="topic-rule"></div><div class="topic-grid cols-2"><article class="topic-card"><h3>景點地址</h3><p>{place.address}</p><p>導航時請核對地圖顯示的景點名稱與實際入口；名稱相近的場館不可共用定位。</p></article><article class="topic-card"><h3>地圖與交通</h3><p>{detail.transit}</p><p><a href={mapUrl} target="_blank" rel="noopener noreferrer">開啟{place.name}專屬 Google 地圖搜尋 ↗</a></p></article></div></section>

  <section class="topic-section"><h2>常見問題</h2><div class="topic-rule"></div><div class="faq-list">{faq.map((item, index) => <article class="faq-item"><h3><button type="button" aria-expanded={index === 0 ? "true" : "false"} aria-controls={`nearby-${index}`} data-faq-button><span>{item.question}</span><span class="faq-plus" aria-hidden="true"></span></button></h3><div id={`nearby-${index}`} class="faq-answer" hidden={index !== 0}><p>{item.answer}</p></div></article>)}</div></section>

  <section class="topic-section"><h2>資料來源與更新</h2><div class="topic-rule"></div><p>基本資料與遊覽特點參考<a href={place.source} target="_blank" rel="noopener noreferrer">政府觀光／文化公開資料</a>，管理背景參考<a href={detail.managerSource} target="_blank" rel="noopener noreferrer">管理機關資料</a>，2026-11-18 查閱。照片來源：<a href={place.photoSource} target="_blank" rel="noopener noreferrer">查看原始頁面</a>。營業、展覽、票價與入口為動態資訊，出發前請向管理單位核實。本站的建議停留時間屬行程規劃估計，非官方標準。</p></section>

  <TopicLinks heading="接著探索夜市" />
</TopicPage>
