---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { visitorFacilities } from "../data/site";
---

<section id="services" class="section section-warm facilities-section" aria-labelledby="services-title">
  <div class="shell">
    <SectionHeading
      id="services-title"
      eyebrow="訪客服務與周邊設施"
      title="出發前先了解：洗手間、停車、餐飲與住宿"
      description="以下以「設施類型」做客觀說明，協助你安排動線與補給。本站為非營利科普網站，不推薦、也不指名任何特定商家。"
    />

    <ul class="facility-grid">
      {visitorFacilities.map((item) => (
        <li class="facility-card">
          <span class="facility-icon" aria-hidden="true"><Icon name={item.icon as any} size={22} /></span>
          <div class="facility-body">
            <p class="facility-label">{item.label}</p>
            <h3>{item.title}</h3>
            <ul class="facility-points">
              {item.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <p class="facility-note">{item.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
