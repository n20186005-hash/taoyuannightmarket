---
import Icon from "./Icon.astro";

interface Props {
  rating: number;
  reviewCount: number;
  mapsUrl: string;
  syncLabel: string;
}

const { rating, reviewCount, mapsUrl, syncLabel } = Astro.props;

const fullStars = Math.floor(rating);
const hasHalf = rating - fullStars >= 0.5;
const stars = Array.from({ length: 5 }, (_, i) => {
  if (i < fullStars) return "full";
  if (i === fullStars && hasHalf) return "half";
  return "empty";
});
const ratingText = rating.toFixed(1);
const reviewText = reviewCount.toLocaleString("en-US");
---

<section id="reviews" class="section section-paper reviews-section" aria-labelledby="reviews-title">
  <div class="shell reviews-card">
    <p class="eyebrow">來自 Google 地圖的旅客評價</p>
    <h2 id="reviews-title" class="reviews-title">真實旅客怎麼看桃園觀光夜市</h2>

    <div class="reviews-head">
      <div class="reviews-score" aria-hidden="true">
        <span class="reviews-number">{ratingText}</span>
        <span class="reviews-outof">/ 5</span>
      </div>
      <div class="reviews-stars" role="img" aria-label={`Google 地圖評分 ${ratingText} 分（滿分 5 分），約 ${reviewText} 則評價`}>
        {stars.map((type) => (
          <span class="star">
            <svg class="star-base" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.98l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96z" /></svg>
            <span class="star-fill" style={`width:${type === "full" ? 100 : type === "half" ? 50 : 0}%`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.4l2.95 5.98 6.6.96-4.78 4.66 1.13 6.57L12 17.98l-5.9 3.1 1.13-6.57L2.45 9.34l6.6-.96z" /></svg>
            </span>
          </span>
        ))}
      </div>
      <p class="reviews-count">{reviewText} 則評價</p>
    </div>

    <p class="reviews-attribution">
      評分與評價數同步自谷歌地圖（Google Maps）用戶評價 · {syncLabel} · <a href={mapsUrl} target="_blank" rel="noopener noreferrer">點擊查看谷歌地圖全部評價↗</a>
    </p>
    <p class="reviews-source">
      同步自 Google 地圖用戶評價，同步時間 {syncLabel}；版權歸原作者與 Google 地圖所有。
    </p>

    <a class="button button-primary reviews-button" href={mapsUrl} target="_blank" rel="noopener noreferrer">
      在谷歌地图查看全部评价
      <Icon name="arrow" size={18} />
    </a>
  </div>
</section>
